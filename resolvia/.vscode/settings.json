{
  "python.defaultInterpreterPath": "${workspaceFolder}/backend/venv/Scripts/python.exe",
  "python.terminal.activateEnvironment": true,
  "[python]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "ms-python.python"
  },
  "editor.tabSize": 4,
  "files.associations": {
    "*.html": "html",
    "*.css": "css",
    "*.sql": "sql"
  }
}
