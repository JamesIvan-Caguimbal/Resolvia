{
  // VS Code launch configuration for Resolvia
  // Press F5 to start the Flask backend from VS Code
  "version": "0.2.0",
  "configurations": [
    {
      "name": "▶ Run Flask Backend",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/backend/app.py",
      "cwd": "${workspaceFolder}/backend",
      "env": {
        "FLASK_ENV": "development",
        "FLASK_PORT": "5000"
      },
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
